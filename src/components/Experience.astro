---
import { getContent, isOn } from '../lib/content';
const { experience: e, ui, lang } = getContent(Astro.currentLocale);
const h = e.haystack;
const L = e.layout ?? {};
---
<section class="section" data-space={e.layout?.spacing} id="experience" aria-labelledby="exp-title">
  <div class="wrap" data-reveal>
    <div class="sh">
      <div><span class="eyebrow">{e.eyebrow}</span><h2 class="h2" id="exp-title">{e.title}</h2></div>
    </div>

    <div class:list={["timeline", { "no-line": !isOn(L.showTimeline) }]} data-timeline>
      <article class="job">
        <div class="job-side">
          <span class="meta">{h.period}</span>
          {h.logo && isOn(L.showLogos) && <img class="org-logo" src={h.logo} alt={h.company.split(' · ')[0]} style={`height:${h.logoHeight || 30}px`} loading="lazy">}
        </div>
        <div>
          <div><h3 class="h3">{h.title}</h3><p class="sub">{h.company}</p></div>
          <div class="roles">
            <div class="role-card">
              <div class="role-head">
                <span class="role-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19V10M10 19V5M16 19v-7M22 19H2"/></svg></span>
                <h4>{h.researchTitle || 'Quantitative researcher'}</h4>
              </div>
              <p class="muted">{h.intro}</p>
              {isOn(L.showSteps) && <ol class="role-steps" aria-label={ui.howProject}>
                {h.steps.map((s, i) => (
                  <li><span class="step-n">{String(i + 1).padStart(2, '0')}</span><span><strong>{s.name}</strong>{s.what && <span class="muted"> · {s.what}</span>}</span></li>
                ))}
              </ol>}
            </div>
            {isOn(L.showDataScience) && <div class="role-card">
              <div class="role-head">
                <span class="role-icon alt" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V17h5v-1.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/></svg></span>
                <h4>{h.panelLabel}</h4>
              </div>
              <p class="muted">{h.panelText}</p>
              <ul class="role-uses">
                {h.panelTags.map((t) => {
                  // "Tool → what it gives" or "On our radar: topic"
                  const [a, b] = t.includes('→') ? t.split('→').map((x) => x.trim()) : t.includes(':') ? t.split(':').map((x) => x.trim()).reverse() : [t, ''];
                  return <li><strong>{a.charAt(0).toUpperCase() + a.slice(1)}</strong>{b && <span class="use-note">{t.includes('→') ? `→ ${b}` : b}</span>}</li>;
                })}
              </ul>
              {h.radar?.length > 0 && (
                <div class="role-radar">
                  {h.radarLabel && <strong>{h.radarLabel}</strong>}
                  <ul class="ds-tags">{h.radar.map((t) => <li>{t}</li>)}</ul>
                </div>
              )}
            </div>}
          </div>
          {isOn(L.showSectors) && (h.note || h.studyTypes?.length > 0) && (
            <div class="study-row">
              {h.note && <p class="study-note">{h.note}</p>}
              {h.studyTypes?.length > 0 && <ul class="study-tags" aria-label={ui.studyTypes}>{h.studyTypes.map((t) => <li>{t}</li>)}</ul>}
            </div>
          )}
        </div>
      </article>

      {e.jobs.map((j) => (
        <article class="job">
          <div class="job-side">
            <span class="meta">{j.period}</span>
            {j.logo && isOn(L.showLogos) && <img class="org-logo" src={j.logo} alt={j.company.split(' · ')[0]} style={`height:${j.logoHeight || 30}px`} loading="lazy">}
          </div>
          <div>
            <div><h3 class="h3">{j.title}</h3>{j.company && <p class="sub">{j.company}</p>}</div>
            {j.text && <p style="max-width:62ch;color:var(--ink-2)">{j.text}</p>}
            {j.items.length > 0 && (
              <div class="cols">
                {j.items.map((it) => (
                  <div class="sub-item">
                    {it.logo && <img class="sub-logo" src={it.logo} alt="" style={`height:${it.logoHeight || 40}px`} loading="lazy">}
                    <h4 class="label">{it.title}</h4>
                    <p class="muted">{it.text}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
