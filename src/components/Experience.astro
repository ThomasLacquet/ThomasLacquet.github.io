---
import { getContent, isOn } from '../lib/content';
const { experience: e, ui, lang } = getContent(Astro.currentLocale);
const h = e.haystack;
const L = e.layout ?? {};
---
<section class="section" data-space={e.layout?.spacing} id="experience" aria-labelledby="exp-title">
  <div class="wrap" data-reveal>
    <div class="sh">
      <div><span class="eyebrow">{e.eyebrow}</span><h2 class="h2" id="exp-title">{e.title}</h2></div>
    </div>

    <div class:list={["timeline", { "no-line": !isOn(L.showTimeline) }]} data-timeline>
      <article class="job">
        <div class="job-side">
          <span class="meta">{h.period}</span>
          {h.logo && isOn(L.showLogos) && <img class="org-logo" src={h.logo} alt={h.company.split(' · ')[0]} style={`height:${h.logoHeight || 30}px`} loading="lazy">}
        </div>
        <div>
          <div><h3 class="h3">{h.title}</h3><p class="sub">{h.company}</p></div>
          <div class="hay">
            <div class="hay-main">
              <p class="job-intro">{h.intro}</p>
              {isOn(L.showSteps) && <ol class="steps" aria-label={ui.howProject}>
                {h.steps.map((s, i) => (
                  <li class={i === h.steps.length - 1 ? 'last' : ''}>
                    <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
                    <span><strong>{s.name}</strong>{s.what && <span class="muted"> · {s.what}</span>}</span>
                  </li>
                ))}
              </ol>}
            </div>
            {isOn(L.showDataScience) && <div class="ds-card">
              <span class="eyebrow">{h.panelLabel}</span>
              <h4>{h.panelTitle}</h4>
              <p>{h.panelText}</p>
              <ul class="ds-tags">{h.panelTags.map((t) => <li>{t}</li>)}</ul>
            </div>}
          </div>
          {isOn(L.showSectors) && (h.note || h.studyTypes?.length > 0) && (
            <div class="study-row">
              {h.note && <p class="study-note">{h.note}</p>}
              {h.studyTypes?.length > 0 && <ul class="study-tags" aria-label={ui.studyTypes}>{h.studyTypes.map((t) => <li>{t}</li>)}</ul>}
            </div>
          )}
        </div>
      </article>

      {e.jobs.map((j) => (
        <article class="job">
          <div class="job-side">
            <span class="meta">{j.period}</span>
            {j.logo && isOn(L.showLogos) && <img class="org-logo" src={j.logo} alt={j.company.split(' · ')[0]} style={`height:${j.logoHeight || 30}px`} loading="lazy">}
          </div>
          <div>
            <div><h3 class="h3">{j.title}</h3>{j.company && <p class="sub">{j.company}</p>}</div>
            {j.text && <p style="max-width:62ch;color:var(--ink-2)">{j.text}</p>}
            {j.items.length > 0 && (
              <div class="cols">
                {j.items.map((it) => (
                  <div class="sub-item">
                    {it.logo && <img class="sub-logo" src={it.logo} alt="" style={`height:${it.logoHeight || 40}px`} loading="lazy">}
                    <h4 class="label">{it.title}</h4>
                    <p class="muted">{it.text}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
